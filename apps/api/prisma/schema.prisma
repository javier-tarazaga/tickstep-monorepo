// Prisma schema for the TickStep API.
// Models map to the existing snake_case tables defined in scripts/init-db.sql,
// so the generated client works against the current database without a data migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Transaction-mode pooler (PgBouncer, port 6543) for the running app.
  url       = env("DATABASE_URL")
  // Session-mode pooler (port 5432) used by Prisma Migrate / introspection.
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  todoLists       TodoList[]
  sidebarLayout   SidebarLayout?
  labels          Label[]
  listMemberships TodoListMember[]

  @@map("users")
}

model TodoList {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(255)
  emoji     String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  todos   Todo[]
  members TodoListMember[]

  @@index([userId], map: "idx_todo_lists_user_id")
  @@map("todo_lists")
}

// A collaborator on a shared list. The list's `userId` remains the canonical
// owner (never appears here); rows here are the invited members. `role` is
// always "member" today — it exists so future roles (editor/viewer) are a
// data change, not a migration.
model TodoListMember {
  listId    String   @map("list_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("member") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  todoList TodoList @relation(fields: [listId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([listId, userId])
  @@index([userId], map: "idx_todo_list_members_user_id")
  @@map("todo_list_members")
}

model Todo {
  id          String    @id @default(uuid()) @db.Uuid
  todoListId  String    @map("todo_list_id") @db.Uuid
  title       String    @db.VarChar(200)
  description String?
  completed   Boolean   @default(false)
  dueDate     DateTime? @map("due_date") @db.Timestamptz(6)
  priority    String?   @map("priority") @db.VarChar(10)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  todoList   TodoList    @relation(fields: [todoListId], references: [id], onDelete: Cascade)
  todoLabels TodoLabel[]

  @@index([todoListId], map: "idx_todos_todo_list_id")
  @@index([completed], map: "idx_todos_completed")
  @@map("todos")
}

model Label {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(50)
  color     String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  todoLabels TodoLabel[]

  @@unique([userId, name], map: "labels_user_id_name_unique")
  @@index([userId], map: "idx_labels_user_id")
  @@map("labels")
}

model TodoLabel {
  todoId  String @map("todo_id") @db.Uuid
  labelId String @map("label_id") @db.Uuid

  todo  Todo  @relation(fields: [todoId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([todoId, labelId])
  @@index([labelId], map: "idx_todo_labels_label_id")
  @@map("todo_labels")
}

model SidebarLayout {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique(map: "sidebar_layouts_user_id_unique") @map("user_id") @db.Uuid
  layout    Json     @default("{\"sections\":[],\"unsectionedListIds\":[]}")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sidebar_layouts")
}
