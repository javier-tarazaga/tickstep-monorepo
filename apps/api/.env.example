# Database — Prisma connection strings
# Supabase Postgres via the connection pooler (find host/region in Dashboard > Connect):
#   DATABASE_URL = transaction-mode pooler (port 6543, app runtime)
#   DIRECT_URL   = session-mode pooler (port 5432, used by Prisma Migrate)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# Local Docker PostgreSQL alternative (see docker-compose.yml):
# DATABASE_URL="postgresql://tickstep:tickstep_dev@localhost:5432/tickstep?schema=public"
# DIRECT_URL="postgresql://tickstep:tickstep_dev@localhost:5432/tickstep?schema=public"

# Supabase (auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Server
PORT=3000
