{
  "name": "@tickstep/desktop",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package": "electron-builder --mac -c.electronVersion=$(node -p \"require('electron/package.json').version\")",
    "clean": "rm -rf dist out *.tsbuildinfo"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@tickstep/api-client": "workspace:*",
    "@tickstep/shared-types": "workspace:*",
    "@tickstep/shared-utils": "workspace:*",
    "emoji-mart": "^5.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0",
    "electron-vite": "^3.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.tickstep.desktop",
    "productName": "Tickstep",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "directories": {
      "output": "release"
    }
  }
}
